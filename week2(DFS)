class Node:
    def __init__(self, board, parent=None, move=None, depth=0):
        self.board = board
        self.parent = parent
        self.move = move
        self.depth = depth
        self.blank_pos = self.find_blank()

    def find_blank(self):
        for r in range(3):
            for c in range(3):
                if self.board[r][c] == 0:
                    return (r, c)
        return None

    def get_successors(self):
        successors = []
        r, c = self.blank_pos
        deltas = [(-1, 0, "Up"), (1, 0, "Down"), (0, -1, "Left"), (0, 1, "Right")]
        for dr, dc, move_name in deltas:
            nr, nc = r + dr, c + dc
            if 0 <= nr < 3 and 0 <= nc < 3:
                new_board = [row[:] for row in self.board]
                new_board[r][c], new_board[nr][nc] = new_board[nr][nc], new_board[r][c]
                successors.append(Node(new_board, self, move_name, self.depth + 1))
        return successors

    def is_goal(self, goal):
        return self.board == goal

    def get_path(self):
        node, moves, board_states = self, [], []
        while node:
            moves.append(node.move)
            board_states.append(node.board)
            node = node.parent
        # Reverse the lists to get order from start to goal
        # moves[::-1][1:] removes the initial 'None' move (from the start node)
        return moves[::-1][1:], board_states[::-1]

def solve_dfs(initial_board, goal_board, max_depth=20):
    start_node = Node(initial_board)
    stack = [start_node]
    visited = set()

    while stack:
        current = stack.pop()
        board_tuple = tuple(tuple(row) for row in current.board)

        if current.is_goal(goal_board):
            return current.get_path()

        if board_tuple not in visited:
            visited.add(board_tuple)
            if current.depth < max_depth:
                for succ in reversed(current.get_successors()):
                    succ_tuple = tuple(tuple(row) for row in succ.board)
                    if succ_tuple not in visited:
                        stack.append(succ)
    return None, None # Return None for both moves and board_states if no solution


initial = [[1, 2, 3], [0, 4, 6], [7, 5, 8]]
goal =    [[1, 2, 3], [4, 5, 6], [7, 8, 0]]

print("Initial Board:")
for row in initial:
    print(row)

print("\nGoal Board:")
for row in goal:
    print(row)

moves_dfs, board_states_dfs = solve_dfs(initial, goal)

if moves_dfs:
    print("\nDFS Solution Found:")
    print(f"DFS Path Cost: {len(moves_dfs)} moves")
    print("DFS Transition States:")
    print("--- Initial State ---")
    for row in board_states_dfs[0]:
        print(row)
    print()

    for i in range(len(moves_dfs)):
        print(f"--- Step {i+1}: Move {moves_dfs[i]} ---")
        for row in board_states_dfs[i+1]:
            print(row)
        print()
else:
    print("\nDFS: No solution found within the maximum depth.")

