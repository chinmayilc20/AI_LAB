def depth_limited_search(node, goal_board, limit, visited):
    if node.is_goal(goal_board):
        return node
    if node.depth == limit:
        return None

    board_tuple = tuple(tuple(row) for row in node.board)
    visited.add(board_tuple)
    for succ in node.get_successors():
        succ_tuple = tuple(tuple(row) for row in succ.board)
        if succ_tuple not in visited:
            result = depth_limited_search(succ, goal_board, limit, visited)
            if result is not None:
                return result
    visited.remove(board_tuple)
    return None

